<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="z3-feed" value="./.z3-feed" />
  </packageSources>

  <!-- ADR 0030: Microsoft.Z3 comes only from the local feed filled by tools/z3-feed/fetch.ps1
       (the official Z3Prover/z3 GitHub release nupkg); every other package still comes only
       from nuget.org. -->
  <packageSourceMapping>
    <packageSource key="z3-feed">
      <package pattern="Microsoft.Z3" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
