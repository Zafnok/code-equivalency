# Divergent
# Exception type: both throw when a is 0, with different exception types.
proc "T::M(int)" (%a: bv32) entry B0
B0:
  %zero: bv32 = const bv32 0
  %isZero: bool = eq %a, %zero
  br %isZero, B1, B2
B1:
  throw "System.DivideByZeroException"
B2:
  ret
---
proc "T::M(int)" (%a: bv32) entry B0
B0:
  %zero: bv32 = const bv32 0
  %isZero: bool = eq %a, %zero
  br %isZero, B1, B2
B1:
  throw "System.ArgumentException"
B2:
  ret
