# Equivalent
# ADR 0041, P2-060: call-heap-order with a closed callee. A closed call writes no map, so the field read before it and the one read after it are one value.
proc "C::M(int)" (%a: bv32, ref %field.C.f: map<sort "C", bv32>, %this: sort "C") -> bv32 entry B0
B0:
  %x: bv32 = mapread %field.C.f, %this
  %s: bv32 = call closed "System.Math::Abs(int)"(%a)
  ret %x outs(%field.C.f = %field.C.f)
---
proc "C::M(int)" (%a: bv32, ref %field.C.f: map<sort "C", bv32>, %this: sort "C") -> bv32 entry B0
B0:
  %s: bv32 = call closed "System.Math::Abs(int)"(%a)
  %x: bv32 = mapread %field.C.f, %this
  ret %x outs(%field.C.f = %field.C.f)
