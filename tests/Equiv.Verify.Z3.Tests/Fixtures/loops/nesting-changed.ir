# Equivalent(chc)
# Counting to n with a loop whose body runs an inner loop once, against a loop followed by one that never runs:
# equal, with two loops on each side, but nested on one side and one after the other on the other, so rungs 2 and
# 3 do not align them and rung 4 proves it over the integers.
proc "T::Nested(int)" (%n "n": bv32) -> bv32 entry B0
B0:
  %z: bv32 = const bv32 0
  %one: bv32 = const bv32 1
  goto B1
B1:
  %i "i": bv32 = phi [B0: %z, B4: %i1]
  %s "s": bv32 = phi [B0: %z, B4: %t]
  %c: bool = slt %i, %n
  br %c, B2, B5
B2:
  %j "j": bv32 = phi [B1: %z, B3: %j1]
  %t "s": bv32 = phi [B1: %s, B3: %t1]
  %d: bool = slt %j, %one
  br %d, B3, B4
B3:
  %t1 "s": bv32 = add %t, %one
  %j1 "j": bv32 = add %j, %one
  goto B2
B4:
  %i1 "i": bv32 = add %i, %one
  goto B1
B5:
  ret %s
---
proc "T::Nested(int)" (%n "n": bv32) -> bv32 entry B0
B0:
  %z: bv32 = const bv32 0
  %one: bv32 = const bv32 1
  goto B1
B1:
  %i "i": bv32 = phi [B0: %z, B2: %i1]
  %s "s": bv32 = phi [B0: %z, B2: %s1]
  %c: bool = slt %i, %n
  br %c, B2, B3
B2:
  %s1 "s": bv32 = add %s, %one
  %i1 "i": bv32 = add %i, %one
  goto B1
B3:
  goto B4
B4:
  %j "j": bv32 = phi [B3: %z, B5: %j1]
  %t "s": bv32 = phi [B3: %s, B5: %t1]
  %d: bool = slt %j, %z
  br %d, B5, B6
B5:
  %t1 "s": bv32 = add %t, %one
  %j1 "j": bv32 = add %j, %one
  goto B4
B6:
  ret %t
