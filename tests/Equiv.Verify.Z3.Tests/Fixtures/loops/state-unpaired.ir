# Unknown(UnalignedLoop)
# The new side hoists a constant out of the loop: its header has a live-in the old header lacks.
proc "T::Sum(int)" (%n "n": bv32) -> bv32 entry B0
B0:
  %z: bv32 = const bv32 0
  goto B1
B1:
  %i "i": bv32 = phi [B0: %z, B2: %i1]
  %c: bool = slt %i, %n
  br %c, B2, B3
B2:
  %one: bv32 = const bv32 1
  %i1 "i": bv32 = add %i, %one
  goto B1
B3:
  ret %i
---
proc "T::Sum(int)" (%n "n": bv32) -> bv32 entry B0
B0:
  %z: bv32 = const bv32 0
  %one: bv32 = const bv32 1
  goto B1
B1:
  %i "i": bv32 = phi [B0: %z, B2: %i1]
  %c: bool = slt %i, %n
  br %c, B2, B3
B2:
  %i1 "i": bv32 = add %i, %one
  goto B1
B3:
  ret %i
