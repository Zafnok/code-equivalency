# Equivalent(lockstep-induction)
# Unchanged nested loops: every header is a cut point, and the inner loop's exit carries the outer state.
proc "T::Nested(int)" (%n "n": bv32) -> bv32 entry B0
B0:
  %z: bv32 = const bv32 0
  %one: bv32 = const bv32 1
  goto B1
B1:
  %i "i": bv32 = phi [B0: %z, B4: %i1]
  %s "s": bv32 = phi [B0: %z, B4: %t]
  %c: bool = slt %i, %n
  br %c, B2, B5
B2:
  %j "j": bv32 = phi [B1: %z, B3: %j1]
  %t "s": bv32 = phi [B1: %s, B3: %t1]
  %d: bool = slt %j, %i
  br %d, B3, B4
B3:
  %t1 "s": bv32 = add %t, %one
  %j1 "j": bv32 = add %j, %one
  goto B2
B4:
  %i1 "i": bv32 = add %i, %one
  goto B1
B5:
  ret %s
---
proc "T::Nested(int)" (%n "n": bv32) -> bv32 entry B0
B0:
  %z: bv32 = const bv32 0
  %one: bv32 = const bv32 1
  goto B1
B1:
  %i "i": bv32 = phi [B0: %z, B4: %i1]
  %s "s": bv32 = phi [B0: %z, B4: %t]
  %c: bool = slt %i, %n
  br %c, B2, B5
B2:
  %j "j": bv32 = phi [B1: %z, B3: %j1]
  %t "s": bv32 = phi [B1: %s, B3: %t1]
  %d: bool = slt %j, %i
  br %d, B3, B4
B3:
  %t1 "s": bv32 = add %t, %one
  %j1 "j": bv32 = add %j, %one
  goto B2
B4:
  %i1 "i": bv32 = add %i, %one
  goto B1
B5:
  ret %s
