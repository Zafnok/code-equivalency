# Equivalent(chc)
# Two unnamed header phis in the opposite order: paired by position they start unequal, so the base
# obligation fails, and its model does not replay to a divergence (the procedures agree). Rung 4 proves it over
# the bitvectors: a + 1 overflows once n is the maximum, so integer mode is ruled out.
proc "T::Swap(int)" (%n: bv32) -> bv32 entry B0
B0:
  %z: bv32 = const bv32 0
  %one: bv32 = const bv32 1
  goto B1
B1:
  %i: bv32 = phi [B0: %z, B2: %i1]
  %a: bv32 = phi [B0: %one, B2: %a1]
  %c: bool = slt %i, %n
  br %c, B2, B3
B2:
  %i1: bv32 = add %i, %one
  %a1: bv32 = add %a, %one
  goto B1
B3:
  ret %i
---
proc "T::Swap(int)" (%n: bv32) -> bv32 entry B0
B0:
  %z: bv32 = const bv32 0
  %one: bv32 = const bv32 1
  goto B1
B1:
  %a: bv32 = phi [B0: %one, B2: %a1]
  %i: bv32 = phi [B0: %z, B2: %i1]
  %c: bool = slt %i, %n
  br %c, B2, B3
B2:
  %i1: bv32 = add %i, %one
  %a1: bv32 = add %a, %one
  goto B1
B3:
  ret %i
