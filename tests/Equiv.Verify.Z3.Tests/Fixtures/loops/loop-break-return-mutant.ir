# Divergent(bounded)
# loop-break-return with one line changed: the return inside the loop returns i instead of s.
proc "T::Scan(int,int)" (%n "n": bv32, %k "k": bv32) -> bv32 entry B0
B0:
  %z: bv32 = const bv32 0
  %one: bv32 = const bv32 1
  %cap: bv32 = const bv32 100
  goto B1
B1:
  %i "i": bv32 = phi [B0: %z, B4: %i1]
  %s "s": bv32 = phi [B0: %z, B4: %s1]
  %c: bool = slt %i, %n
  br %c, B2, B5
B2:
  %hit: bool = eq %i, %k
  br %hit, B3, B6
B3:
  ret %s
B6:
  %full: bool = sgt %s, %cap
  br %full, B5, B4
B4:
  %s1 "s": bv32 = add %s, %i
  %i1 "i": bv32 = add %i, %one
  goto B1
B5:
  %r: bv32 = add %s, %one
  ret %r
---
proc "T::Scan(int,int)" (%n "n": bv32, %k "k": bv32) -> bv32 entry B0
B0:
  %z: bv32 = const bv32 0
  %one: bv32 = const bv32 1
  %cap: bv32 = const bv32 100
  goto B1
B1:
  %i "i": bv32 = phi [B0: %z, B4: %i1]
  %s "s": bv32 = phi [B0: %z, B4: %s1]
  %c: bool = slt %i, %n
  br %c, B2, B5
B2:
  %hit: bool = eq %i, %k
  br %hit, B3, B6
B3:
  ret %i
B6:
  %full: bool = sgt %s, %cap
  br %full, B5, B4
B4:
  %s1 "s": bv32 = add %s, %i
  %i1 "i": bv32 = add %i, %one
  goto B1
B5:
  %r: bv32 = add %s, %one
  ret %r
