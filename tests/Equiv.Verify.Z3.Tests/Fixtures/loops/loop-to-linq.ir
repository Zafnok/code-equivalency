# Unknown(ChcTimeout, int)
# One loop computing a sum and a count, rewritten as LINQ's two passes (Sum(), Count()): equivalent, but one
# loop against two does not align, so rungs 2 and 3 do not apply, and within this fixture's 50 ms Spacer finds no
# invariant over the integers.
proc "T::Stats(int)" (%n "n": bv32) -> bv32 entry B0
B0:
  %z: bv32 = const bv32 0
  %one: bv32 = const bv32 1
  goto B1
B1:
  %i "i": bv32 = phi [B0: %z, B2: %i1]
  %s "sum": bv32 = phi [B0: %z, B2: %s1]
  %p "count": bv32 = phi [B0: %z, B2: %p1]
  %c: bool = slt %i, %n
  br %c, B2, B3
B2:
  %s1 "sum": bv32 = add %s, %i
  %p1 "count": bv32 = add %p, %one
  %i1 "i": bv32 = add %i, %one
  goto B1
B3:
  %r: bv32 = add %s, %p
  ret %r
---
proc "T::Stats(int)" (%n "n": bv32) -> bv32 entry B0
B0:
  %z: bv32 = const bv32 0
  %one: bv32 = const bv32 1
  goto B1
B1:
  %i "i": bv32 = phi [B0: %z, B2: %i1]
  %s "sum": bv32 = phi [B0: %z, B2: %s1]
  %c: bool = slt %i, %n
  br %c, B2, B3
B2:
  %s1 "sum": bv32 = add %s, %i
  %i1 "i": bv32 = add %i, %one
  goto B1
B3:
  goto B4
B4:
  %j "j": bv32 = phi [B3: %z, B5: %j1]
  %p "count": bv32 = phi [B3: %z, B5: %p1]
  %d: bool = slt %j, %n
  br %d, B5, B6
B5:
  %p1 "count": bv32 = add %p, %one
  %j1 "j": bv32 = add %j, %one
  goto B4
B6:
  %r: bv32 = add %s, %p
  ret %r
