# Equivalent(lockstep-induction)
# An unchanged self-recursive procedure that writes the heap: rung 1 cannot inline it, rung 2 proves it.
proc "T::Mark(int)" (%n: bv32, %this: sort "T", ref %field.T.seen: map<sort "T", bv32>) entry B0
B0:
  %w: map<sort "T", bv32> = mapwrite %field.T.seen, %this, %n
  %z: bv32 = const bv32 0
  %c: bool = sle %n, %z
  br %c, B1, B2
B1:
  ret outs(%field.T.seen = %w)
B2:
  %one: bv32 = const bv32 1
  %m: bv32 = sub %n, %one
  call "T::Mark(int)"(%this, %m) threw %t: bool
  br %t, B3, B1
B3:
  throw "System.Exception" outs(%field.T.seen = %w)
---
proc "T::Mark(int)" (%n: bv32, %this: sort "T", ref %field.T.seen: map<sort "T", bv32>) entry B0
B0:
  %w: map<sort "T", bv32> = mapwrite %field.T.seen, %this, %n
  %z: bv32 = const bv32 0
  %c: bool = sle %n, %z
  br %c, B1, B2
B1:
  ret outs(%field.T.seen = %w)
B2:
  %one: bv32 = const bv32 1
  %m: bv32 = sub %n, %one
  call "T::Mark(int)"(%this, %m) threw %t: bool
  br %t, B3, B1
B3:
  throw "System.Exception" outs(%field.T.seen = %w)
