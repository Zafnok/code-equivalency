# Equivalent(lockstep-induction)
# An unchanged self-recursive procedure: the self-call is a call both sides share (mutual summary).
proc "T::F(int)" (%n: bv32) -> bv32 entry B0
B0:
  %z: bv32 = const bv32 0
  %one: bv32 = const bv32 1
  %c: bool = sle %n, %z
  br %c, B1, B2
B1:
  ret %z
B2:
  %m: bv32 = sub %n, %one
  %r: bv32 = call "T::F(int)"(%m) threw %t: bool
  br %t, B3, B4
B3:
  throw "System.Exception"
B4:
  %s: bv32 = add %r, %one
  ret %s
---
