# Equivalent(chc, bitvector)
# n + n, which overflows for a large n, decides an early return; then a loop whose two unnamed header phis are in
# the opposite order on the new side: paired by position they start unequal, so rung 2's base fails. The pair can
# overflow, so no proof over the integers stands; Spacer's invariant over the integers holds with wrap-around
# arithmetic too, which proves the pair over the bitvectors.
proc "T::Count(int)" (%n: bv32) -> bv32 entry B0
B0:
  %z: bv32 = const bv32 0
  %one: bv32 = const bv32 1
  %twice: bv32 = add %n, %n
  %negative: bool = slt %twice, %z
  br %negative, B4, B1
B4:
  ret %z
B1:
  %i: bv32 = phi [B0: %z, B2: %i1]
  %a: bv32 = phi [B0: %one, B2: %a1]
  %more: bool = slt %i, %n
  br %more, B2, B3
B2:
  %i1: bv32 = add %i, %one
  %a1: bv32 = add %a, %one
  goto B1
B3:
  ret %i
---
proc "T::Count(int)" (%n: bv32) -> bv32 entry B0
B0:
  %z: bv32 = const bv32 0
  %one: bv32 = const bv32 1
  %twice: bv32 = add %n, %n
  %negative: bool = slt %twice, %z
  br %negative, B4, B1
B4:
  ret %z
B1:
  %a: bv32 = phi [B0: %one, B2: %a1]
  %i: bv32 = phi [B0: %z, B2: %i1]
  %more: bool = slt %i, %n
  br %more, B2, B3
B2:
  %i1: bv32 = add %i, %one
  %a1: bv32 = add %a, %one
  goto B1
B3:
  ret %i
