# Divergent(chc, int)
# Identical bodies, ten iterations against eleven (the bound is a constant of the header, so both headers carry the
# same state): beyond rung 1's bound, and rungs 2 and 3 align the loops but their steps fail at the last iteration.
# Only rung 4 refutes it: its derivation over the integers runs eleven iterations and replays to 20 against 22.
proc "T::Twice()" () -> bv32 entry B0
B0:
  %z: bv32 = const bv32 0
  %one: bv32 = const bv32 1
  %two: bv32 = const bv32 2
  goto B1
B1:
  %i "i": bv32 = phi [B0: %z, B2: %i1]
  %s "s": bv32 = phi [B0: %z, B2: %s1]
  %bound: bv32 = const bv32 10
  %c: bool = slt %i, %bound
  br %c, B2, B3
B2:
  %s1 "s": bv32 = add %s, %two
  %i1 "i": bv32 = add %i, %one
  goto B1
B3:
  ret %s
---
proc "T::Twice()" () -> bv32 entry B0
B0:
  %z: bv32 = const bv32 0
  %one: bv32 = const bv32 1
  %two: bv32 = const bv32 2
  goto B1
B1:
  %i "i": bv32 = phi [B0: %z, B2: %i1]
  %s "s": bv32 = phi [B0: %z, B2: %s1]
  %bound: bv32 = const bv32 11
  %c: bool = slt %i, %bound
  br %c, B2, B3
B2:
  %s1 "s": bv32 = add %s, %two
  %i1 "i": bv32 = add %i, %one
  goto B1
B3:
  ret %s
