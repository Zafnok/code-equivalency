# Equivalent(chc, bitvector)
# A cycle with two entries (never produced by the Roslyn CFG): rungs 1 to 3 do not cut it, but rung 4 cuts at every
# back-edge target, and since d is always true no run leaves the cycle, so no pair of runs ever exits, with
# wrap-around arithmetic too.
proc "T::Tangle(bool,int)" (%c: bool, %n: bv32) -> bv32 entry B0
B0:
  br %c, B1, B2
B1:
  %d: bool = eq %n, %n
  br %d, B2, B3
B2:
  goto B1
B3:
  ret %n
---
proc "T::Tangle(bool,int)" (%c: bool, %n: bv32) -> bv32 entry B0
B0:
  br %c, B1, B2
B1:
  %d: bool = eq %n, %n
  br %d, B2, B3
B2:
  goto B1
B3:
  ret %n
