# Divergent(k-induction)
# Ten iterations; the new side adds 1 in the one with i == 2: beyond rung 1's bound, a failing step for rung 2,
# and a state difference within the 3-induction base, whose model replays to a divergence (with n as the
# bound instead of ten, the model's n is usually too large for the replay to finish, and the pair is Unknown).
proc "T::Late()" () -> bv32 entry B0
B0:
  %z: bv32 = const bv32 0
  %one: bv32 = const bv32 1
  %at: bv32 = const bv32 2
  %ten: bv32 = const bv32 10
  goto B1
B1:
  %i "i": bv32 = phi [B0: %z, B5: %i1]
  %s "s": bv32 = phi [B0: %z, B5: %s1]
  %c: bool = slt %i, %ten
  br %c, B2, B3
B2:
  %hit: bool = eq %i, %at
  br %hit, B4, B5
B4:
  %s2 "s": bv32 = mul %s, %one
  goto B5
B5:
  %s1 "s": bv32 = phi [B2: %s, B4: %s2]
  %i1 "i": bv32 = add %i, %one
  goto B1
B3:
  ret %s
---
proc "T::Late()" () -> bv32 entry B0
B0:
  %z: bv32 = const bv32 0
  %one: bv32 = const bv32 1
  %at: bv32 = const bv32 2
  %ten: bv32 = const bv32 10
  goto B1
B1:
  %i "i": bv32 = phi [B0: %z, B5: %i1]
  %s "s": bv32 = phi [B0: %z, B5: %s1]
  %c: bool = slt %i, %ten
  br %c, B2, B3
B2:
  %hit: bool = eq %i, %at
  br %hit, B4, B5
B4:
  %s2 "s": bv32 = add %s, %one
  goto B5
B5:
  %s1 "s": bv32 = phi [B2: %s, B4: %s2]
  %i1 "i": bv32 = add %i, %one
  goto B1
B3:
  ret %s
