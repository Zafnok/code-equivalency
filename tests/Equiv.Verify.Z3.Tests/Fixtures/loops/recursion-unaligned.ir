# Unknown(Recursion)
# F(n) = n <= 0 ? 0 : F(n - 1) + 1 against a version that recurses on n - 2: equal, but the self-calls do not
# line up, and the bound cuts the inlined recursion off.
proc "T::F(int)" (%n: bv32) -> bv32 entry B0
B0:
  %z: bv32 = const bv32 0
  %one: bv32 = const bv32 1
  %c: bool = sle %n, %z
  br %c, B1, B2
B1:
  ret %z
B2:
  %m: bv32 = sub %n, %one
  %r: bv32 = call "T::F(int)"(%m) threw %t: bool
  br %t, B3, B4
B3:
  throw "System.Exception"
B4:
  %s: bv32 = add %r, %one
  ret %s
---
proc "T::F(int)" (%n: bv32) -> bv32 entry B0
B0:
  %z: bv32 = const bv32 0
  %one: bv32 = const bv32 1
  %c: bool = sle %n, %z
  br %c, B1, B2
B1:
  ret %z
B2:
  %e: bool = eq %n, %one
  br %e, B5, B6
B5:
  ret %one
B6:
  %two: bv32 = const bv32 2
  %m: bv32 = sub %n, %two
  %r: bv32 = call "T::F(int)"(%m) threw %t: bool
  br %t, B3, B4
B3:
  throw "System.Exception"
B4:
  %s: bv32 = add %r, %two
  ret %s
