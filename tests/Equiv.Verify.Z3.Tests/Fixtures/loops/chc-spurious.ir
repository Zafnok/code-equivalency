# Unknown(ChcSpurious)
# Counting the odd numbers below n, the new side with a pre-incremented counter from -1: equal, but the counters
# start apart, so rungs 2 and 3 fail. Nothing overflows, so rung 4 runs over the integers, where i & 1 is not
# modelled (any integer in bounds, chosen apart on each side): its derivation does not replay to a divergence.
proc "T::Odd(int)" (%n "n": bv32) -> bv32 entry B0
B0:
  %z: bv32 = const bv32 0
  %one: bv32 = const bv32 1
  goto B1
B1:
  %i "i": bv32 = phi [B0: %z, B4: %i1]
  %c "count": bv32 = phi [B0: %z, B4: %c1]
  %more: bool = slt %i, %n
  br %more, B2, B5
B2:
  %bit: bv32 = and %i, %one
  %odd: bool = eq %bit, %one
  br %odd, B3, B4
B3:
  %c2 "count": bv32 = add %c, %one
  goto B4
B4:
  %c1 "count": bv32 = phi [B2: %c, B3: %c2]
  %i1 "i": bv32 = add %i, %one
  goto B1
B5:
  ret %c
---
proc "T::Odd(int)" (%n "n": bv32) -> bv32 entry B0
B0:
  %m: bv32 = const bv32 -1
  %z: bv32 = const bv32 0
  %one: bv32 = const bv32 1
  goto B1
B1:
  %k "k": bv32 = phi [B0: %m, B4: %k1]
  %c "count": bv32 = phi [B0: %z, B4: %c1]
  %k1 "k": bv32 = add %k, %one
  %more: bool = slt %k1, %n
  br %more, B2, B5
B2:
  %bit: bv32 = and %k1, %one
  %odd: bool = eq %bit, %one
  br %odd, B3, B4
B3:
  %c2 "count": bv32 = add %c, %one
  goto B4
B4:
  %c1 "count": bv32 = phi [B2: %c, B3: %c2]
  goto B1
B5:
  ret %c
