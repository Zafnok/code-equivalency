  %len: bv32 = mapread %length.int__, %a
  %one: bv32 = const bv32 1
  %j: bv32 = add %i, %one
  %c: bool = uge %j, %len
  br %c, B1, B2
B1:
  %x: bv32 = mapread %elems, %j
