# Divergent(chc, int)
# As late-divergence, but in the iteration with i == 5: beyond every window of rungs 1 to 3; rung 4 finds a
# derivation over the integers through all ten iterations, which replays to the divergence.
proc "T::Late()" () -> bv32 entry B0
B0:
  %z: bv32 = const bv32 0
  %one: bv32 = const bv32 1
  %at: bv32 = const bv32 5
  %ten: bv32 = const bv32 10
  goto B1
B1:
  %i "i": bv32 = phi [B0: %z, B5: %i1]
  %s "s": bv32 = phi [B0: %z, B5: %s1]
  %c: bool = slt %i, %ten
  br %c, B2, B3
B2:
  %hit: bool = eq %i, %at
  br %hit, B4, B5
B4:
  %s2 "s": bv32 = mul %s, %one
  goto B5
B5:
  %s1 "s": bv32 = phi [B2: %s, B4: %s2]
  %i1 "i": bv32 = add %i, %one
  goto B1
B3:
  ret %s
---
proc "T::Late()" () -> bv32 entry B0
B0:
  %z: bv32 = const bv32 0
  %one: bv32 = const bv32 1
  %at: bv32 = const bv32 5
  %ten: bv32 = const bv32 10
  goto B1
B1:
  %i "i": bv32 = phi [B0: %z, B5: %i1]
  %s "s": bv32 = phi [B0: %z, B5: %s1]
  %c: bool = slt %i, %ten
  br %c, B2, B3
B2:
  %hit: bool = eq %i, %at
  br %hit, B4, B5
B4:
  %s2 "s": bv32 = add %s, %one
  goto B5
B5:
  %s1 "s": bv32 = phi [B2: %s, B4: %s2]
  %i1 "i": bv32 = add %i, %one
  goto B1
B3:
  ret %s
