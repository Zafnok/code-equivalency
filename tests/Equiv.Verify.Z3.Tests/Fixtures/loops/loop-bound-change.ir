# Divergent(bounded)
# samples/loop-bound-change as IR: the new guard is <= instead of <. Rung 1 finds n = 1 within 3 iterations.
proc "T::Sum(int)" (%n "n": bv32) -> bv32 entry B0
B0:
  %z: bv32 = const bv32 0
  %one: bv32 = const bv32 1
  goto B1
B1:
  %i "i": bv32 = phi [B0: %z, B2: %i1]
  %s "s": bv32 = phi [B0: %z, B2: %s1]
  %c: bool = slt %i, %n
  br %c, B2, B3
B2:
  %s1 "s": bv32 = add %s, %i
  %i1 "i": bv32 = add %i, %one
  goto B1
B3:
  ret %s
---
proc "T::Sum(int)" (%n "n": bv32) -> bv32 entry B0
B0:
  %z: bv32 = const bv32 0
  %one: bv32 = const bv32 1
  goto B1
B1:
  %i "i": bv32 = phi [B0: %z, B2: %i1]
  %s "s": bv32 = phi [B0: %z, B2: %s1]
  %c: bool = sle %i, %n
  br %c, B2, B3
B2:
  %s1 "s": bv32 = add %s, %i
  %i1 "i": bv32 = add %i, %one
  goto B1
B3:
  ret %s
