# Divergent(lockstep-induction)
# Every input runs ten iterations, so rung 1 sees nothing; the value computed before the loop differs, the
# base obligation fails, and its model replays through the original procedures to a divergence.
proc "T::Ten(int)" (%a "a": bv32) -> bv32 entry B0
B0:
  %z: bv32 = const bv32 0
  %one: bv32 = const bv32 1
  %ten: bv32 = const bv32 10
  %x "x": bv32 = add %a, %one
  goto B1
B1:
  %i "i": bv32 = phi [B0: %z, B2: %i1]
  %c: bool = slt %i, %ten
  br %c, B2, B3
B2:
  %i1 "i": bv32 = add %i, %one
  goto B1
B3:
  ret %x
---
proc "T::Ten(int)" (%a "a": bv32) -> bv32 entry B0
B0:
  %z: bv32 = const bv32 0
  %one: bv32 = const bv32 1
  %ten: bv32 = const bv32 10
  %x "x": bv32 = add %a, %a
  goto B1
B1:
  %i "i": bv32 = phi [B0: %z, B2: %i1]
  %c: bool = slt %i, %ten
  br %c, B2, B3
B2:
  %i1 "i": bv32 = add %i, %one
  goto B1
B3:
  ret %x
