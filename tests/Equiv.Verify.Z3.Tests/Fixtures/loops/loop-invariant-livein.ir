# Equivalent(lockstep-induction)
# m = n + 1 is computed before the loop and read by its guard: a live-in of the header, not a phi.
proc "T::Count(int)" (%n "n": bv32) -> bv32 entry B0
B0:
  %z: bv32 = const bv32 0
  %one: bv32 = const bv32 1
  %m "m": bv32 = add %n, %one
  goto B1
B1:
  %i "i": bv32 = phi [B0: %z, B2: %i1]
  %c: bool = slt %i, %m
  br %c, B2, B3
B2:
  %i1 "i": bv32 = add %i, %one
  goto B1
B3:
  ret %i
---
proc "T::Count(int)" (%n "n": bv32) -> bv32 entry B0
B0:
  %z: bv32 = const bv32 0
  %one: bv32 = const bv32 1
  %m "m": bv32 = add %n, %one
  goto B1
B1:
  %i "i": bv32 = phi [B0: %z, B2: %i1]
  %c: bool = slt %i, %m
  br %c, B2, B3
B2:
  %i1 "i": bv32 = add %i, %one
  goto B1
B3:
  ret %i
