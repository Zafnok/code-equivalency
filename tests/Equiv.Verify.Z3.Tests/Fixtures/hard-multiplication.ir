proc "T::Rebuild(ulong, ulong)" (%a: bv64, %b: bv64) -> bv64 entry B0
B0:
  %q: bv64 = udiv %a, %b
  %m: bv64 = mul %q, %b
  %r: bv64 = urem %a, %b
  %s: bv64 = add %m, %r
  ret %s
---
proc "T::Rebuild(ulong, ulong)" (%a: bv64, %b: bv64) -> bv64 entry B0
