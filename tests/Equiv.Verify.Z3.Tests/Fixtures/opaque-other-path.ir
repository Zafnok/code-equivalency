# Divergent
# ADR 0014: the divergence (a >= 0) is on a path that reaches no opaque, next to a branch that does.
proc "T::M(int)" (%a: bv32) -> bv32 entry B0
B0:
  %zero: bv32 = const bv32 0
  %negative: bool = slt %a, %zero
  br %negative, B1, B2
B1:
  opaque "Throw" at "T.cs" 4:13-4:40
  ret %zero
B2:
  ret %a
---
proc "T::M(int)" (%a: bv32) -> bv32 entry B0
B0:
  %zero: bv32 = const bv32 0
  %negative: bool = slt %a, %zero
  br %negative, B1, B2
B1:
  ret %zero
B2:
  %one: bv32 = const bv32 1
  %r: bv32 = add %a, %one
  ret %r
