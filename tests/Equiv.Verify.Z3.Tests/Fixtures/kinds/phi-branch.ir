# Equivalent
proc "T::Abs(int)" (%a: bv32) -> bv32 entry B0
B0:
  %z: bv32 = const bv32 0
  %c: bool = slt %a, %z
  br %c, B1, B2
B1:
  %n: bv32 = neg %a
  goto B3
B2:
  goto B3
B3:
  %r: bv32 = phi [B1: %n, B2: %a]
  ret %r
---
proc "T::Abs(int)" (%a: bv32) -> bv32 entry B0
B0:
  %z: bv32 = const bv32 0
  %c: bool = sge %a, %z
  br %c, B2, B1
B1:
  %n: bv32 = sub %z, %a
  goto B3
B2:
  goto B3
B3:
  %r: bv32 = phi [B2: %a, B1: %n]
  ret %r
