# Equivalent
proc "C::Swap()" (ref %field.C.x: map<sort "C", bv32>, %this: sort "C") -> bv32 entry B0
B0:
  %old: bv32 = mapread %field.C.x, %this
  %one: bv32 = const bv32 1
  %x1: map<sort "C", bv32> = mapwrite %field.C.x, %this, %one
  goto B1
B1:
  ret %old outs(%field.C.x = %x1)
---
proc "C::Swap()" (ref %field.C.x: map<sort "C", bv32>, %this: sort "C") -> bv32 entry B0
B0:
  %one: bv32 = const bv32 1
  %zero: bv32 = const bv32 0
  %x0: map<sort "C", bv32> = mapwrite %field.C.x, %this, %zero
  %x1: map<sort "C", bv32> = mapwrite %x0, %this, %one
  %old: bv32 = mapread %field.C.x, %this
  goto B1
B1:
  ret %old outs(%field.C.x = %x1)
