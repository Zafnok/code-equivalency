# Equivalent
# A pure function and its exception flags are shared by both sides (ADR 0025; ticket M4-002).
proc "T::M(decimal,decimal)" (%a: sort "System.Decimal", %b: sort "System.Decimal") -> sort "System.Decimal" entry B0
B0:
  %q: sort "System.Decimal" = pure "dec.div"(%a, %b) throws(%z: bool "System.DivideByZeroException", %o: bool "System.OverflowException")
  br %z, B1, B2
B1:
  throw "System.DivideByZeroException"
B2:
  br %o, B3, B4
B3:
  throw "System.OverflowException"
B4:
  ret %q
---
proc "T::M(decimal,decimal)" (%a: sort "System.Decimal", %b: sort "System.Decimal") -> sort "System.Decimal" entry B0
B0:
  %q: sort "System.Decimal" = pure "dec.div"(%a, %b) throws(%z: bool "System.DivideByZeroException", %o: bool "System.OverflowException")
  br %z, B1, B2
B1:
  throw "System.DivideByZeroException"
B2:
  br %o, B3, B4
B3:
  throw "System.OverflowException"
B4:
  ret %q
