# Equivalent
proc "T::M(int)" (%a: bv32) -> bv32 entry B0
B0:
  %z: bv32 = const bv32 0
  %c: bool = eq %a, %z
  br %c, B1, B2
B1:
  unreachable
B2:
  ret %a
