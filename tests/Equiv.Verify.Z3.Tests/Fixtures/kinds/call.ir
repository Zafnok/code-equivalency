# Equivalent
proc "T::M(int)" (%a: bv32) -> bv32 entry B0
B0:
  %r: bv32 = call "Svc::F(int)"(%a) threw %t: bool
  br %t, B1, B2
B1:
  throw "System.Exception"
B2:
  call "Svc::G()"()
  ret %r
