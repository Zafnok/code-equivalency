# Divergent
proc "T::M(int)" (%a: bv32) -> bv32 entry B0
B0:
  switch %a [bv32 1 -> B1, bv32 2 -> B1, bv32 1 -> B2] default B2
B1:
  %x: bv32 = const bv32 10
  ret %x
B2:
  %y: bv32 = const bv32 20
  ret %y
---
proc "T::M(int)" (%a: bv32) -> bv32 entry B0
B0:
  switch %a [bv32 1 -> B1] default B2
B1:
  %x: bv32 = const bv32 10
  ret %x
B2:
  %y: bv32 = const bv32 20
  ret %y
