# Divergent
proc "T::M(sbyte)" (%a: bv8) -> bv32 entry B0
B0:
  %w: bv32 = sext %a
  goto B1
B1:
  %n: bv32 = neg %w
  ret %n
---
proc "T::M(sbyte)" (%a: bv8) -> bv32 entry B0
B0:
  %n8: bv8 = neg %a
  goto B1
B1:
  %w: bv32 = sext %n8
  %t: bv8 = trunc %w
  %z: bv32 = zext %t
  %x: bv32 = not %z
  %c: bool = const bool true
  %nc: bool = boolnot %c
  ret %w
