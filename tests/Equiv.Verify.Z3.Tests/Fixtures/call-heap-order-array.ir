# Divergent
# P1-005, the array counterpart of call-heap-order: the old side reads an element before the call, the new side after it, and the call may write it.
proc "C::M(int[])" (%a: sort "int[]", ref %array.int__: map<sort "int[]", map<bv32, bv32>>) -> bv32 entry B0
B0:
  %i: bv32 = const bv32 0
  %row: map<bv32, bv32> = mapread %array.int__, %a
  %x: bv32 = mapread %row, %i
  call "C::Foo()"() heap("array.int__" %array.int__ -> %e1: map<sort "int[]", map<bv32, bv32>>)
  ret %x outs(%array.int__ = %e1)
---
proc "C::M(int[])" (%a: sort "int[]", ref %array.int__: map<sort "int[]", map<bv32, bv32>>) -> bv32 entry B0
B0:
  %i: bv32 = const bv32 0
  call "C::Foo()"() heap("array.int__" %array.int__ -> %e1: map<sort "int[]", map<bv32, bv32>>)
  %row: map<bv32, bv32> = mapread %e1, %a
  %x: bv32 = mapread %row, %i
  ret %x outs(%array.int__ = %e1)
