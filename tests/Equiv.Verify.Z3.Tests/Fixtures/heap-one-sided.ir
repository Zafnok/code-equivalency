# Equivalent
# ADR 0018: only old names field.C.x, and it writes back the value it read; compared against the shared input.
proc "C::Get(int)" (%v: bv32, ref %field.C.x: map<sort "C", bv32>, %this: sort "C") -> bv32 entry B0
B0:
  %x: bv32 = mapread %field.C.x, %this
  %x1: map<sort "C", bv32> = mapwrite %field.C.x, %this, %x
  ret %v outs(%field.C.x = %x1)
---
proc "C::Get(int)" (%v: bv32, %this: sort "C") -> bv32 entry B0
B0:
  ret %v
