# Divergent
# ADR 0041, P2-060: a closed call's result is a function of its arguments and position alone, and the replay answers it without a heap, beside an open call that threads one.
proc "C::M(int)" (%a: bv32, ref %field.C.f: map<sort "C", bv32>, %this: sort "C") -> bv32 entry B0
B0:
  %r: bv32 = call closed "System.Math::Abs(int)"(%a)
  call "C::Foo()"(%this) heap("field.C.f" %field.C.f -> %f1: map<sort "C", bv32>)
  ret %r outs(%field.C.f = %f1)
---
proc "C::M(int)" (%a: bv32, ref %field.C.f: map<sort "C", bv32>, %this: sort "C") -> bv32 entry B0
B0:
  %r: bv32 = call closed "System.Math::Abs(int)"(%a)
  call "C::Foo()"(%this) heap("field.C.f" %field.C.f -> %f1: map<sort "C", bv32>)
  %s: bv32 = add %r, %r
  ret %s outs(%field.C.f = %f1)
