# Equivalent
# a + a vs a * 2, logged through the same call and returned.
proc "T::M(int)" (%a: bv32) -> bv32 entry B0
B0:
  %r: bv32 = add %a, %a
  call "Log::Write(int)"(%r)
  ret %r
---
proc "T::M(int)" (%a: bv32) -> bv32 entry B0
B0:
  %two: bv32 = const bv32 2
  %r: bv32 = mul %a, %two
  call "Log::Write(int)"(%r)
  ret %r
