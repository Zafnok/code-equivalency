# Divergent
# ADR 0021: callers bind C# parameters by position, so swapping two names in the signature swaps the arguments.
proc "T::Sub(int, int)" (%a: bv32, %b: bv32) -> bv32 entry B0
B0:
  %r: bv32 = sub %a, %b
  ret %r
---
proc "T::Sub(int, int)" (%b: bv32, %a: bv32) -> bv32 entry B0
B0:
  %r: bv32 = sub %a, %b
  ret %r
