    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
    <PackageVersion Include="Verify.XunitV3" Version="33.3.2" />
    <PackageVersion Include="CsCheck" Version="4.9.1" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.4" />

    <!-- all projects (see Directory.Build.props) -->
