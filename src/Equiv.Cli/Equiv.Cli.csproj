<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- P2-132: the Windows executable asks for the segment heap, so that pair workers inside Z3 do not wait on the
         process heap's lock (app.manifest). The SDK copies the manifest into the apphost and the single-file
         bundle. It does nothing on Linux, where each thread has a malloc arena of its own. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- M3-004 criterion 1: single-file, self-contained win-x64/linux-x64 publish, Z3's native
         bundled via IncludeNativeLibrariesForSelfExtract. Gated on a RuntimeIdentifier being set
         (i.e. `dotnet publish -r <rid>`); without one, Equiv.Cli.Tests' ProjectReference to this
         project would fail (NETSDK1151: a self-contained exe cannot be referenced by one that isn't). -->
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(RuntimeIdentifier)' != ''">true</IncludeNativeLibrariesForSelfExtract>
    <!-- Microsoft.CodeAnalysis.Workspaces.MSBuild ships its out-of-process BuildHost as Content
         (contentFiles/any/any/BuildHost-net472, BuildHost-netcore): real .exe/.dll files the
         workspace spawns as a separate process, found relative to AppContext.BaseDirectory.
         Bundled into the single file (the default), they exist only inside the bundle, not on
         disk, so the workspace's process-spawn fails ("build host could not be found"). This
         extracts every Content file to the self-extraction temp dir alongside the native libraries,
         restoring the on-disk layout the workspace expects. -->
    <IncludeAllContentForSelfExtract Condition="'$(RuntimeIdentifier)' != ''">true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <!-- M5-001: `equiv mcp` serves the compare pipeline over stdio (ADR 0033). -->
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Equiv.Core\Equiv.Core.csproj" />
    <!-- M4-009: the execute option replays each Divergent on both real runtimes (ADR 0035). -->
    <ProjectReference Include="..\Equiv.Execute\Equiv.Execute.csproj" />
    <ProjectReference Include="..\Equiv.Frontend.CSharp\Equiv.Frontend.CSharp.csproj" />
    <!-- P1-033: cvc5 is the second solver when equiv.config.json names its executable (ADR 0050). -->
    <ProjectReference Include="..\Equiv.Verify.Cvc5\Equiv.Verify.Cvc5.csproj" />
    <ProjectReference Include="..\Equiv.Verify.Z3\Equiv.Verify.Z3.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Equiv.Cli.Tests" />
    <!-- M2-002: this ticket's Equiv.Tests.Integration tests drive CompareCommand.Run end to end. -->
    <InternalsVisibleTo Include="Equiv.Tests.Integration" />
  </ItemGroup>

</Project>
