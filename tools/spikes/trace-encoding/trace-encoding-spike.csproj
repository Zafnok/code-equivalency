<Project Sdk="Microsoft.NET.Sdk">

  <!--
    P1-034: a throwaway measurement, not a product. It is not in Equiv.slnx, so no CI gate builds it.
    The assembly name borrows the integration tests' InternalsVisibleTo grant on Equiv.Frontend.CSharp and
    Equiv.Verify.Z3, as the P1-025 spike did, so src/ is unchanged (the size guard). No lock file: the spike adds
    no package, and the other solvers are run as processes, never referenced. Style analyzers are off: this is
    measurement code, not product code; compiler warnings stay errors.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>TraceEncodingSpike</RootNamespace>
    <AssemblyName>Equiv.Tests.Integration</AssemblyName>
    <StartupObject>TraceEncodingSpike.Program</StartupObject>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Equiv.Frontend.CSharp\Equiv.Frontend.CSharp.csproj" />
  </ItemGroup>

  <!-- P1-025's rung 1, export, solver runs and read-back, reused as they are (namespace SolverPortfolioSpike). -->
  <ItemGroup>
    <Compile Include="..\solver-portfolio\Program.cs" Link="SolverPortfolio\Program.cs" />
    <Compile Include="..\solver-portfolio\Rung1.cs" Link="SolverPortfolio\Rung1.cs" />
    <Compile Include="..\solver-portfolio\SelfTest.cs" Link="SolverPortfolio\SelfTest.cs" />
  </ItemGroup>

  <!--
    Microsoft.Z3 restores only from the local .z3-feed that tools/z3-feed/fetch.ps1 fills (ADR 0030), or from the global
    packages folder once some restore has put it there. GitHub's automatic dependency submission restores every project
    outside Equiv.slnx on a clean runner without running fetch.ps1, so with neither present the reference is left out and
    that restore succeeds. Building the spike needs one of them, as every Equiv.Verify.Z3 build does.
  -->
  <PropertyGroup>
    <SpikeGlobalPackages>$(NUGET_PACKAGES)</SpikeGlobalPackages>
    <SpikeGlobalPackages Condition="'$(SpikeGlobalPackages)' == '' and '$(USERPROFILE)' != ''">$(USERPROFILE)\.nuget\packages</SpikeGlobalPackages>
    <SpikeGlobalPackages Condition="'$(SpikeGlobalPackages)' == ''">$(HOME)/.nuget/packages</SpikeGlobalPackages>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\.z3-feed') or Exists('$(SpikeGlobalPackages)/microsoft.z3')">
    <ProjectReference Include="..\..\..\src\Equiv.Verify.Z3\Equiv.Verify.Z3.csproj" />
  </ItemGroup>

</Project>
